# PostgreSQL local. Copie este arquivo para .env e ajuste se necessário.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clanhub?schema=public"

# Chave criada em https://developer.clashofclans.com/ (My Account).
# Fica somente no servidor. Nunca use o prefixo NEXT_PUBLIC_.
# A Supercell exige que o IP de saída esteja autorizado na chave.
CLASH_API_KEY=""

# Tag pública do único clã gerenciado. O # inicial é opcional.
CLAN_TAG="2CLG8LJ2J"

# Intervalo da dashboard, em milissegundos. Mínimo 15000, máximo 600000.
# A guerra atual continua em cache no servidor por 60s, então o polling
# não repete a consulta à Supercell dentro dessa janela.
CLASH_POLL_INTERVAL_MS="60000"
